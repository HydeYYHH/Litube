<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Activities use ComponentActivity and Compose Material3. A framework
         window theme avoids retaining the separate Material Views library. -->
    <style name="Theme.App.Base" parent="android:style/Theme.Material.Light.NoActionBar" />
    <style name="Theme.App" parent="Theme.App.Base">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorOnSurface">@color/window_icon_color</item>
        <item name="colorOnSurfaceVariant">@color/window_icon_variant</item>
        <item name="colorControlNormal">@color/window_icon_control</item>
    </style>

    <style name="Theme.App.DownloadSheet" parent="Theme.App">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
