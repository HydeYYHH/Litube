<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework window theme: avoids retaining the separate Material Views library. -->
    <style name="Theme.App.Base" parent="android:style/Theme.Material.Light.NoActionBar" />
    <style name="Theme.App" parent="Theme.App.Base">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorOnSurface">@color/window_icon_color</item>
        <item name="colorOnSurfaceVariant">@color/window_icon_variant</item>
        <item name="colorControlNormal">@color/window_icon_control</item>
    </style>

    <style name="Theme.App.Dialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:textColorPrimary">#0F0F0F</item>
        <item name="android:textColorSecondary">#606060</item>
        <item name="android:colorAccent">#0F0F0F</item>
    </style>
    <style name="Theme.App.Dialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorBackgroundFloating">#000000</item>
        <item name="android:textColorPrimary">#F1F1F1</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:colorAccent">#F1F1F1</item>
    </style>

    <style name="Theme.App.DownloadSheet" parent="Theme.App">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shorts stay black from the starting window through the first video frame. -->
    <style name="Theme.App.Shorts.Base" parent="Theme.App.Base">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.App.Shorts" parent="Theme.App.Shorts.Base" />

    <style name="Theme.App.Home" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#0F0F0F</item>
    </style>

    <!-- windowDisablePreview: a theme-only preview would insert a white frame before our first draw. -->
    <style name="Theme.App.Watch" parent="Theme.App.Home">
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
