<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude in-progress download state so Auto Backup cannot clobber Room rows
  or temp files. MMKV (legacy download_history) stays included so a restored
  legacy backup can still run the importer once.
  Paths: DownloadBackupExcludes
-->
<full-backup-content>
    <exclude domain="database" path="downloader.db" />
    <exclude domain="database" path="downloader.db-wal" />
    <exclude domain="database" path="downloader.db-shm" />
    <exclude domain="cache" path="download" />
    <exclude domain="file" path="download" />
    <exclude domain="root" path="no_backup" />
    <exclude domain="root" path="no_backup/player" />
</full-backup-content>
