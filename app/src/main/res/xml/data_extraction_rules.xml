<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes the download database, temp dir, playback/PoToken cache and sealed
  credential store (media-auth) from cloud backup and device transfer.
  See DownloadBackupExcludes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="downloader.db" />
        <exclude domain="database" path="downloader.db-wal" />
        <exclude domain="database" path="downloader.db-shm" />
        <exclude domain="file" path="download" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="root" path="no_backup/player" />
        <exclude domain="sharedpref" path="media-auth.xml" />
        <exclude domain="sharedpref" path="media-cache.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="downloader.db" />
        <exclude domain="database" path="downloader.db-wal" />
        <exclude domain="database" path="downloader.db-shm" />
        <exclude domain="file" path="download" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="root" path="no_backup/player" />
        <exclude domain="sharedpref" path="media-auth.xml" />
        <exclude domain="sharedpref" path="media-cache.xml" />
    </device-transfer>
</data-extraction-rules>
