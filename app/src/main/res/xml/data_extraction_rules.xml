<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device transfer exclude the download database, temp dir,
  and playback/PoToken cache. See DownloadBackupExcludes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="downloader.db" />
        <exclude domain="database" path="downloader.db-wal" />
        <exclude domain="database" path="downloader.db-shm" />
        <exclude domain="cache" path="download" />
        <exclude domain="file" path="download" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="root" path="no_backup/player" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="downloader.db" />
        <exclude domain="database" path="downloader.db-wal" />
        <exclude domain="database" path="downloader.db-shm" />
        <exclude domain="cache" path="download" />
        <exclude domain="file" path="download" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="root" path="no_backup/player" />
    </device-transfer>
</data-extraction-rules>
